# Firebase Environment Configuration — Portal Talentos OSS
# NOTE: Estos son placeholders ficticios. Para desarrollo local, copia este archivo
# a .env y coloca tus credenciales de consola Firebase o usa emuladores.
# Nunca commitear credenciales reales.

# Vite variables must have VITE_ prefix to be injected into client code
VITE_FIREBASE_API_KEY=<<apiKey>>
VITE_FIREBASE_AUTH_DOMAIN=<<projectId>>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<<projectId>>
VITE_FIREBASE_STORAGE_BUCKET=<<projectId>>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<<messagingSenderId>>
VITE_FIREBASE_APP_ID=<<appId>>

# NOTE: La autorización de administrador se basa EXCLUSIVAMENTE en custom
# claims del ID token (admin: true, y opcionalmente superAdmin: true),
# no en el correo electrónico.
#
# Para asignar claims en EMULADORES locales (proyecto de test):
#   FIREBASE_PROJECT_ID=<TU_PROYECTO_TEST> \
#     node scripts/admin-claims.mjs --uid USER_UID [--superadmin] --apply
#   (Lista de proyectos permitidos configurable con FIREBASE_ALLOWED_PROJECT_IDS=id1,id2)
#
# Para asignar claims en el entorno REMOTO (ver scripts/DEPLOYMENT_GUIDE.md y
# scripts/admin-claims-remote.mjs) se requiere además un service account REAL:
#   FIREBASE_PROJECT_ID=<TU_PROYECTO> FIREBASE_SERVICE_ACCOUNT=/ruta/sa.json \
#     node scripts/admin-claims-remote.mjs --uid USER_UID [--superadmin] --apply
# NO se descargan ni generan service accounts sin autorización explícita.

# Admin configuration (for server-side only, not injected into client)
# These are typically set via Firebase Admin SDK or Firebase Console
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# (No incluyas claves privadas ni service accounts en el repositorio)